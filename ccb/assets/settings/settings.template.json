{
  "ccb": {
    "version": "0.4.1",
    "managed": true
  },
  "hooks": {
    "SessionStart": [
      {
        "_ccb": true,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ccb_python}} \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "_ccb": true,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ccb_python}} \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_end.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "_ccb": true,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ccb_python}} \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_compact.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_ccb": true,
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{ccb_python}} \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_use.py\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "_ccb": true,
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ccb_python}} \"${CLAUDE_PROJECT_DIR}/.claude/hooks/instructions_loaded.py\""
          }
        ]
      }
    ]
  }
}
